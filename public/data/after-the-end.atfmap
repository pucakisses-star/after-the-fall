{"format":"after-the-fall/map","appVersion":"0.1.0","schemaVersion":1,"savedAt":"2026-08-19T18:19:25.450Z","project":{"schemaVersion":1,"id":"5fd9b0fd-e81e-4c25-bed2-451069d7f131","meta":{"title":"After the End","subtitle":"The realms of North America","author":"After the Fall \u2014 a map of the After the End setting","dateLine":"In the Year 2666","notes":"Realm names, their tier and the empire each belongs to follow the After the End realm list. The shapes are grown outward from each realm's seat of power rather than traced from modern administrative boundaries, and the land nobody claimed is left as wilderness. The plate covers North America down to Mexico's southern border; the isthmus, the Caribbean and South America are drawn but unclaimed. Every border is an ordinary editable territory.","createdAt":"2026-08-16T09:01:53.663Z","modifiedAt":"2026-08-19T18:14:14.203Z"},"projection":{"id":"ATF:AMERICAS","name":"Americas (Lambert Azimuthal)","proj4":"+proj=laea +lat_0=20 +lon_0=-95 +x_0=0 +y_0=0 +a=6378137 +b=6378137 +units=m +no_defs","extent":[-8756557.411744967,-8661669.03519778,7899435.794392328,7252872.509107055],"units":"m"},"view":{"center":[-101.79806639026921,45.72760311401326],"zoom":3.4690438904275247,"rotation":0},"workingExtent":[-172,-58,-30,76],"layers":{"a1ddf67c-c234-41c8-8567-e134b16db648":{"id":"a1ddf67c-c234-41c8-8567-e134b16db648","name":"Reference Image","kind":"reference-image","parentId":null,"visible":true,"locked":false,"opacity":1,"collapsed":false,"order":0},"ce4a8a54-e232-44f5-b941-1508e1236f6f":{"id":"ce4a8a54-e232-44f5-b941-1508e1236f6f","name":"Ocean","kind":"ocean","parentId":null,"visible":true,"locked":false,"opacity":1,"collapsed":false,"order":1},"0177a7a9-0cfd-4a7c-8c99-496bf8bfcbc9":{"id":"0177a7a9-0cfd-4a7c-8c99-496bf8bfcbc9","name":"Coastline","kind":"basemap","parentId":null,"visible":true,"locked":false,"opacity":1,"collapsed":false,"order":2},"61520ad2-239a-41d8-8010-3e1e7be04911":{"id":"61520ad2-239a-41d8-8010-3e1e7be04